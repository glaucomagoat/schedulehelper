# Set these in Netlify Dashboard > Site Settings > Environment Variables.
# Nothing here is embedded in the client — index.html and techs.html hold no secrets.

# ── Doctor scheduler (existing) ──────────────────────────────────────────────
# Anthropic key for AI schedule generation — https://console.anthropic.com/
ANTHROPIC_API_KEY=sk-ant-api03-your-key-here
# Signs the per-user session JWTs used by storage-proxy and the AI proxy.
SESSION_SECRET=long-random-string
DEV_USERNAME=
DEV_PASSWORD=
CVE_USER=
CVE_PASS=
# Read-only partner JSON feed (optional)
PARTNER_API_KEY=
PARTNER_ORIGIN=https://example.com,https://www.example.com


# ── Technician scheduler ─────────────────────────────────────────────────────

# Which admin namespace the technician functions read and write. They run without a
# user session (public day links, cron, webhooks) so the tenant is fixed here.
TECH_ADMIN_USERNAME=cve

# Signs the per-technician day-view links and Telegram invite tokens. Rotating this
# invalidates every link ever issued, so treat it as permanent. Generate with:
#   openssl rand -base64 32
LINK_SECRET=

# Shared secret for the cron -> background-sender call. Generate the same way.
INTERNAL_SECRET=

# Absolute public origin, used to build links inside messages. Without it the
# functions fall back to the request origin, which is right for `netlify dev` and
# deploy previews but wrong for anything sent from the cron.
PUBLIC_BASE_URL=https://your-site.netlify.app


# ── Channel: Telegram (free, unlimited) ──────────────────────────────────────
# From @BotFather. Leave blank to disable the channel entirely — the app detects
# an unconfigured channel and skips it rather than failing.
TELEGRAM_BOT_TOKEN=
# Bot handle without the @, used to build t.me invite links.
TELEGRAM_BOT_USERNAME=
# Any random string. Pass the SAME value to setWebhook so inbound updates can be
# proven to come from Telegram:
#   curl "https://api.telegram.org/bot<TOKEN>/setWebhook" \
#     -d "url=https://your-site.netlify.app/.netlify/functions/telegram-webhook" \
#     -d "secret_token=<TELEGRAM_WEBHOOK_SECRET>"
TELEGRAM_WEBHOOK_SECRET=


# ── Channel: Email via Brevo (free tier: 300/day) — OPTIONAL ─────────────────
# Leave the whole block blank to run Telegram-only. The app detects an unconfigured
# channel and skips it; the admin UI hides the email column and warns that there is
# no fallback. Filling these in later needs no code change or redeploy of logic.
BREVO_API_KEY=
# Must be on a domain with SPF, DKIM and DMARC configured, or roughly a third of
# messages get filtered to spam. Use a real monitored mailbox, never a no-reply.
EMAIL_FROM=scheduling@yourpractice.com
EMAIL_FROM_NAME=Practice Scheduling
# Any random string. Append it to the Brevo webhook URL as ?s=<value>:
#   https://your-site.netlify.app/.netlify/functions/email-webhook?s=<EMAIL_WEBHOOK_SECRET>
EMAIL_WEBHOOK_SECRET=
# Optional override of the provider's daily ceiling used for cap-awareness.
EMAIL_DAILY_CAP=300
